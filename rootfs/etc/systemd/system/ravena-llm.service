[Unit]
Description=RAVENA LLM provider (airLLM - llama-server fallback)
After=ravena-data.service network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/ravena-llm.sh
Restart=on-failure
RestartSec=10
# cgroups v2: isola o llama do trading. MemoryHigh (suave) preserva swap/mmap
# Slice= so vale em [Service]: em [Unit] o systemd imprime
# "Unknown key 'Slice' in section [Unit]" e IGNORA, deixando o servico em
# system.slice (CPUWeight=100) em vez de ravena-llm.slice (CPUWeight=10).
Slice=ravena-llm.slice
CPUQuota=90%
MemoryHigh=6G
MemorySwapMax=8G
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
