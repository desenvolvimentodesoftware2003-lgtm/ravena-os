[Unit]
Description=RAVENA LLM provider (airLLM - llama-server fallback)
After=ravena-data.service network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/ravena-llm.sh
Restart=on-failure
RestartSec=10
# cgroups v2: isola o llama do trading. MemoryHigh (suave) preserva swap/mmap
# Slice= so vale em [Service]: em [Unit] o systemd imprime
# "Unknown key 'Slice' in section [Unit]" e IGNORA, deixando o servico em
# system.slice (CPUWeight=100) em vez de ravena-llm.slice (CPUWeight=10).
# SEM CPUQuota de proposito: o limite e por peso (CPUWeight=10 no slice), o
# llama usa a maquina OCIOSA e cede sozinho quando trading/eDEX disputam.
# CPUQuota aqui tem efeito colateral grave: o nproc dentro do servico passa a
# reportar quota/100% e o llama-server nasce com 1 thread (medido: 90%->1,
# 200%->2, 400%->4) = 0.59 tok/s. Se reaparecer CPUQuota, rever LLM_THREADS.
Slice=ravena-llm.slice
MemoryHigh=6G
MemorySwapMax=8G
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
