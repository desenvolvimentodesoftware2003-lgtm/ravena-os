[Unit]
Description=RAVENA nextboot cleanup (remove one-shot file from ESP)
DefaultDependencies=no
After=local-fs.target systemd-udev-settle.service
Before=multi-user.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/ravena-nextboot-clean.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target