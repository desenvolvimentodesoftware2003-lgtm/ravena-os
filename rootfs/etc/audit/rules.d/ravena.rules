## RAVENA SEC (S7) - regras de auditoria
-w /etc/shadow -p wa -k ravena_id
-w /etc/passwd -p wa -k ravena_id
-w /etc/sudoers -p wa -k ravena_id
-w /etc/sudoers.d/ -p wa -k ravena_id
-w /var/run/utmp -p wa -k ravena_login
-w /etc/ssh/sshd_config -p wa -k ravena_ssh
-w /etc/ssh/sshd_config.d/ -p wa -k ravena_ssh
# execve auditado so quando euid=0 vindo de sessao logada (escalada de
# privilegio). A regra original cobria TODO execve do usuario nas duas
# arquiteturas: com a UI no ar eram ~310 eventos/s no audit.log, auditd a
# 48% de CPU, processos presos em D dentro de audit_log_start, zumbis e
# load 10 em 4 vCPU - o sistema travava e o sshd recusava autenticacao.
-a always,exit -F arch=b64 -S execve -F euid=0 -F auid!=4294967295 -k ravena_exec
